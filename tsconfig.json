{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "//": "Migração incremental: por enquanto o type-check cobre apenas os módulos já convertidos para .ts. Amplie o include conforme converter mais arquivos.",
  "include": [
    "src/App.tsx",
    "src/types.ts",
    "src/vite-env.d.ts",
    "src/lib/library.ts",
    "src/lib/tmdb.ts",
    "src/lib/share.ts",
    "src/lib/contentTypes.ts",
    "src/components/StarRating.tsx",
    "src/components/Toast.tsx",
    "src/components/ItemCard.tsx",
    "src/components/Dashboard.tsx",
    "src/components/DetailModal.tsx",
    "src/components/ConfirmDialog.tsx",
    "src/components/TagManagerModal.tsx",
    "src/components/TmdbHelpModal.tsx",
    "src/components/IosInstallHelp.tsx",
    "src/components/AddEditModal.tsx",
    "src/components/LoginScreen.tsx",
    "src/components/Tutorial.tsx",
    "src/auth/AuthContext.tsx",
    "src/lib/firebase.ts",
    "src/lib/lists.ts",
    "src/components/CreateListModal.tsx",
    "src/components/ManageMembersModal.tsx",
    "src/components/AddToListModal.tsx",
    "src/components/EpisodeTrackerModal.tsx",
    "src/components/PublicListViewer.tsx",
    "src/components/BulkActionBar.tsx",
    "src/components/CompactCard.tsx",
    "src/components/RateOnWatchModal.tsx"
  ]
}
