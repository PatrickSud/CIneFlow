{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "//": "Migração incremental: por enquanto o type-check cobre apenas os módulos já convertidos para .ts. Amplie o include conforme converter mais arquivos.",
  "include": [
    "src/types.ts",
    "src/vite-env.d.ts",
    "src/lib/library.ts",
    "src/lib/tmdb.ts"
  ]
}
