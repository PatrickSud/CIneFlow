rules_version = '2';

// Regras de segurança do Firestore para o CineFlow.
// Cada usuário só pode ler/gravar o próprio documento (users/{uid}).
// Cole estas regras em: Firebase Console -> Firestore Database -> Regras -> Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Listas: membros têm acesso total; listas públicas podem ser lidas por qualquer um.
    match /lists/{listId} {
      allow read: if resource.data.publico == true
        || (request.auth != null && request.auth.token.email in resource.data.memberEmails);
      allow update, delete: if request.auth != null
        && request.auth.token.email in resource.data.memberEmails;
      allow create: if request.auth != null
        && request.auth.token.email in request.resource.data.memberEmails;
    }
  }
}
